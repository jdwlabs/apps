{
  "name": "backend-shared-auth",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/shared/auth",
  "tags": ["type:util", "scope:shared", "framework:go"],
  "implicitDependencies": ["usersrole"],
  "targets": {
    "test": {
      "executor": "@nx-go/nx-go:test",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/backend/usersrole/docs/contracts/*.openapi.yaml"
      ],
      "options": {
        "race": true
      }
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "options": {
        "linter": "go",
        "args": ["vet"]
      }
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    }
  }
}
