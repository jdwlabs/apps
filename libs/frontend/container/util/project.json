{
  "name": "frontend-container-util",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/container/util/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:util", "scope:container", "framework:angular"],
  "implicitDependencies": ["angular-test-host"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "executor": "@nx/angular:unit-test"
    }
  }
}
