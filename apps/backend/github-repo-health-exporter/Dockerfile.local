# Self-contained build for local iteration (no prior `nx build` needed).
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY apps/backend/github-repo-health-exporter/go.mod ./
RUN go mod download || true
COPY apps/backend/github-repo-health-exporter/ ./
RUN CGO_ENABLED=0 go build -o /out/github-repo-health-exporter .

FROM gcr.io/distroless/base-debian12:nonroot AS runner
WORKDIR /app
COPY --from=build /out/github-repo-health-exporter .
EXPOSE 9090
ENTRYPOINT ["/app/github-repo-health-exporter"]
