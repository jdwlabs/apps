{
  "name": "servicediscovery",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/servicediscovery",
  "tags": ["type:app", "scope:servicediscovery", "framework:go"],
  "release": {
    "version": {
      "versionActions": "./tools/release/text-file-version-actions.ts"
    }
  },
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": ".",
        "outputPath": "../../../dist/apps/backend/servicediscovery/servicediscovery"
      }
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "."
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    },
    "build-image": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh servicediscovery {version} {projectRoot}/Dockerfile \"Micro-frontend service discovery API for the jdwlabs platform\" --platform linux/amd64,linux/arm64 --push",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh servicediscovery local {projectRoot}/Dockerfile.local \"Micro-frontend service discovery API for the jdwlabs platform\" --load",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 9000:9000 jdwlabs/servicediscovery:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "update-app": {
      "command": "bash scripts/update-app.sh charts/servicediscovery/Chart.yaml {version} {projectName}"
    },
    "update-description": {
      "command": "bash scripts/update-description.sh jdwlabs/servicediscovery {projectRoot}/README.docker.md"
    },
    "download": {
      "command": "go mod download"
    }
  }
}
