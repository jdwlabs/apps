{
  "name": "identity-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/identity-service",
  "release": {
    "version": {
      "versionActions": "./tools/release/tag-only-version-actions.ts"
    }
  },
  "tags": ["type:app", "scope:identity-service", "framework:go"],
  "implicitDependencies": ["usersrole", "authdb"],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": ".",
        "outputPath": "../../../dist/apps/backend/identity-service/identity-service"
      }
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "."
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/backend/usersrole/docs/contracts/identity-service.openapi.yaml",
        "{workspaceRoot}/apps/database/authdb/src/00_schema.sql",
        "{workspaceRoot}/apps/database/authdb/src/01_data.sql"
      ],
      "options": {
        "race": true
      }
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "options": {
        "linter": "go",
        "args": ["vet"]
      }
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    },
    "build-image": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh identity-service \"$(bash scripts/resolve-version.sh identity-service)\" {projectRoot}/Dockerfile \"Authentication, users and roles API for the jdwlabs platform\" --platform linux/amd64,linux/arm64 --push",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh identity-service local {projectRoot}/Dockerfile.local \"Authentication, users and roles API for the jdwlabs platform\" --load",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 8080:8080 jdwlabs/identity-service:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "update-app": {
      "command": "bash scripts/update-app.sh charts/identity-service/Chart.yaml \"$(bash scripts/resolve-version.sh identity-service)\" {projectName}"
    },
    "update-description": {
      "command": "bash scripts/update-description.sh jdwlabs/identity-service {projectRoot}/README.docker.md"
    },
    "download": {
      "command": "go mod download"
    }
  }
}
