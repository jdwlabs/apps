{
  "name": "usersrole",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/usersrole/src",
  "tags": ["type:app", "scope:usersrole", "framework:springboot"],
  "release": {
    "version": {
      "versionActions": "./tools/release/text-file-version-actions.ts"
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash gradlew assemble"
      },
      "cache": true,
      "outputs": ["{projectRoot}/build/libs"]
    },
    "lint": {
      "cache": true,
      "command": "echo Ignored in project configuration"
    },
    "update-app": {
      "command": "bash scripts/update-app.sh charts/usersrole/Chart.yaml \"$(tr -d '[:space:]' < apps/backend/usersrole/VERSION)\" {projectName}"
    },
    "update-description": {
      "command": "bash scripts/update-description.sh jdwlabs/usersrole {projectRoot}/README.docker.md"
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 8080:8080 jdwlabs/usersrole:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "build-image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "bash gradlew jib",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "bash gradlew jibDockerBuild",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    }
  }
}
