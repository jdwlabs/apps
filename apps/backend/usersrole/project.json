{
  "name": "usersrole",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/usersrole/src",
  "release": {
    "version": {
      "versionActions": "./tools/release/tag-only-version-actions.ts"
    }
  },
  "tags": ["type:app", "scope:usersrole", "framework:springboot"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/build/libs"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash gradlew assemble"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "redocly lint --config {projectRoot}/docs/contracts/redocly.yaml"
      }
    },
    "contract-extract": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/build/openapi"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash gradlew test --tests com.jdw.usersrole.contracts.ServedOpenApiDocumentDumpTests"
      }
    },
    "check-contracts": {
      "executor": "nx:run-commands",
      "dependsOn": ["contract-extract"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node {projectRoot}/scripts/check-contract-drift.mjs"
      }
    },
    "update-app": {
      "command": "bash scripts/update-app.sh charts/usersrole/Chart.yaml \"$(bash scripts/resolve-version.sh usersrole)\" {projectName}"
    },
    "update-description": {
      "command": "bash scripts/update-description.sh jdwlabs/usersrole {projectRoot}/README.docker.md"
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 8080:8080 jdwlabs/usersrole:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "build-image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "bash gradlew jib -PreleaseVersion=\"$(bash ../../../scripts/resolve-version.sh usersrole)\"",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "bash gradlew jibDockerBuild",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    }
  }
}
