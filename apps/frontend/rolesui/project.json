{
  "name": "rolesui",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/frontend/rolesui/src",
  "release": {
    "version": {
      "versionActions": "./tools/release/tag-only-version-actions.ts"
    }
  },
  "tags": ["type:app", "scope:rolesui", "framework:angular"],
  "implicitDependencies": ["module-federation-shared"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/frontend/rolesui",
        "index": "apps/frontend/rolesui/src/index.html",
        "main": "apps/frontend/rolesui/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/frontend/rolesui/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/frontend/shared/ui/src/lib/styles"]
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/frontend/rolesui/public"
          }
        ],
        "styles": ["apps/frontend/rolesui/src/styles.scss"],
        "scripts": [],
        "customWebpackConfig": {
          "path": "apps/frontend/rolesui/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4203,
        "publicHost": "http://localhost:4203",
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "rolesui:build:production"
        },
        "development": {
          "buildTarget": "rolesui:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "rolesui:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.ts",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "rolesui:build",
        "port": 4203,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "rolesui:build:development"
        },
        "production": {
          "buildTarget": "rolesui:build:production"
        }
      }
    },
    "serve-built": {
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "staticFilePath": "dist/apps/frontend/rolesui",
        "port": 4203,
        "watch": false
      }
    },
    "build-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "prepare-config", "build"],
      "options": {
        "commands": [
          {
            "command": "nx run rolesui:prepare-config",
            "forwardAllArgs": false
          },
          {
            "command": "bash scripts/prepare-version.sh apps/frontend/rolesui/public/VERSION \"$(bash scripts/resolve-version.sh rolesui)\"",
            "forwardAllArgs": false
          },
          {
            "command": "nx run rolesui:build --skip-nx-cache",
            "forwardAllArgs": false
          },
          {
            "command": "bash scripts/build-image.sh rolesui \"$(bash scripts/resolve-version.sh rolesui)\" {projectRoot}/Dockerfile \"Roles management micro-frontend for the jdwlabs platform\" --platform linux/amd64,linux/arm64 --push",
            "forwardAllArgs": false
          },
          {
            "command": "bash scripts/restore-version.sh apps/frontend/rolesui/public/VERSION",
            "forwardAllArgs": false
          },
          {
            "command": "nx run rolesui:restore-config",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "prepare-config", "build"],
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh rolesui local {projectRoot}/Dockerfile \"Roles management micro-frontend for the jdwlabs platform\" --load",
            "forwardAllArgs": false
          },
          {
            "command": "nx run rolesui:restore-config",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "update-app": {
      "command": "bash scripts/update-app.sh charts/rolesui/Chart.yaml \"$(bash scripts/resolve-version.sh rolesui)\" {projectName}"
    },
    "update-description": {
      "command": "bash scripts/update-description.sh jdwlabs/rolesui {projectRoot}/README.docker.md"
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 4203:8080 jdwlabs/rolesui:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "prepare-config": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/prepare-config.sh apps/frontend/rolesui/src/config.json"
          }
        ]
      }
    },
    "restore-config": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/restore-config.sh apps/frontend/rolesui/src/config.json"
          }
        ]
      }
    }
  }
}
