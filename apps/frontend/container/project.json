{
  "name": "container",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "jdw",
  "sourceRoot": "apps/frontend/container/src",
  "tags": ["type:app", "scope:container", "framework:angular"],
  "release": {
    "version": {
      "versionActions": "./tools/release/text-file-version-actions.ts",
      "manifestRootsToUpdate": ["{projectRoot}/public"]
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/frontend/container",
        "index": "apps/frontend/container/src/index.html",
        "main": "apps/frontend/container/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/frontend/container/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/frontend/shared/ui/src/lib/styles"]
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/frontend/container/public"
          }
        ],
        "styles": [
          "apps/frontend/container/src/styles.scss",
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/pink-bluegrey.scss",
            "bundleName": "pink-bluegrey"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/deeppurple-amber.scss",
            "bundleName": "deeppurple-amber"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/indigo-pink.scss",
            "bundleName": "indigo-pink"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/purple-green.scss",
            "bundleName": "purple-green"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/red-teal.scss",
            "bundleName": "red-teal"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/black-white.scss",
            "bundleName": "black-white"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/user-custom-dark.scss",
            "bundleName": "custom-dark"
          },
          {
            "inject": false,
            "input": "libs/frontend/shared/ui/src/lib/styles/themes/user-custom-light.scss",
            "bundleName": "custom-light"
          }
        ],
        "scripts": [],
        "customWebpackConfig": {
          "path": "apps/frontend/container/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:module-federation-dev-server",
      "options": {
        "port": 4200,
        "publicHost": "http://localhost:4200"
      },
      "configurations": {
        "production": {
          "buildTarget": "container:build:production"
        },
        "development": {
          "buildTarget": "container:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "container:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/frontend/container/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "container:build",
        "port": 4200
      }
    },
    "build-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "prepare-config", "build"],
      "options": {
        "commands": [
          {
            "command": "nx run container:prepare-config",
            "forwardAllArgs": false
          },
          {
            "command": "nx run container:build --skip-nx-cache",
            "forwardAllArgs": false
          },
          {
            "command": "bash scripts/build-image.sh container \"$(tr -d '[:space:]' < apps/frontend/container/public/VERSION)\" {projectRoot}/Dockerfile \"Angular module-federation host shell for the jdwlabs platform\" --platform linux/amd64,linux/arm64 --push",
            "forwardAllArgs": false
          },
          {
            "command": "nx run container:restore-config",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "prepare-config", "build"],
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh container local {projectRoot}/Dockerfile \"Angular module-federation host shell for the jdwlabs platform\" --load",
            "forwardAllArgs": false
          },
          {
            "command": "nx run container:restore-config",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "update-app": {
      "command": "bash scripts/update-app.sh charts/container/Chart.yaml \"$(tr -d '[:space:]' < apps/frontend/container/public/VERSION)\" {projectName}"
    },
    "update-description": {
      "command": "bash scripts/update-description.sh jdwlabs/container {projectRoot}/README.docker.md"
    },
    "serve-container": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker run --rm -p 4200:80 jdwlabs/container:latest",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "prepare-config": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/prepare-config.sh apps/frontend/container/src/config.json"
          }
        ]
      }
    },
    "restore-config": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/restore-config.sh apps/frontend/container/src/config.json"
          }
        ]
      }
    }
  }
}
