{
  "name": "platform-live-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/e2e/platform-live-e2e/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p apps/e2e/platform-live-e2e/tsconfig.json"
      }
    },
    "test": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --root apps/e2e/platform-live-e2e"
      }
    },
    "generate-contract-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/e2e/platform-live-e2e/scripts/contract-types.mjs"
      }
    },
    "check-contracts": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/apps/backend/usersrole/docs/contracts/*.openapi.yaml",
        "{projectRoot}/src/harness/generated/*.ts",
        "{projectRoot}/scripts/contract-types.mjs"
      ],
      "options": {
        "command": "node apps/e2e/platform-live-e2e/scripts/contract-types.mjs --check"
      }
    },
    "api-gate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test --config apps/e2e/platform-live-e2e/playwright.config.ts --project api-gate"
      }
    },
    "build-image": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh platform-e2e-api \"$(bash scripts/resolve-version.sh platform-live-e2e)\" {projectRoot}/Dockerfile \"Live API gate for the jdwlabs platform\" --build-arg PLAYWRIGHT_VERSION=$(node -p \"require('@playwright/test/package.json').version\") --build-arg OPENAPI_FETCH_VERSION=$(node -p \"require('openapi-fetch/package.json').version\") --platform linux/amd64,linux/arm64 --push",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "local-build-image": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "bash scripts/build-image.sh platform-e2e-api local {projectRoot}/Dockerfile \"Live API gate for the jdwlabs platform\" --build-arg PLAYWRIGHT_VERSION=$(node -p \"require('@playwright/test/package.json').version\") --build-arg OPENAPI_FETCH_VERSION=$(node -p \"require('openapi-fetch/package.json').version\") --load",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      }
    },
    "update-description": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/update-description.sh jdwlabs/platform-e2e-api apps/e2e/platform-live-e2e/README.docker.md"
      }
    }
  },
  "tags": ["type:e2e", "scope:platform", "framework:playwright"],
  "implicitDependencies": ["usersrole"],
  "release": {
    "version": {
      "versionActions": "./tools/release/tag-only-version-actions.ts"
    }
  }
}
